  "scripts": { "test": "node --test \"test/*.test.mjs\"" },
  "peerDependencies": { "three": ">=0.184.0", "orreryjs": ">=0.1.0" },
  "devDependencies": { "three": "^0.184.0" },
  "repository": { "type": "git", "url": "git+https://github.com/mrigankad/Orrery.git", "directory": "packages/devtools" },
  "homepage": "https://mrigankad.github.io/Orrery/",
  "keywords": ["three", "threejs", "devtools", "inspector", "webgpu", "orrery"],
  "license": "MIT"
