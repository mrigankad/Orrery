{
  "name": "orreryjs",
  "version": "0.1.0",
  "description": "Batteries for three.js: a World with sane defaults, auto-dispose, object events and loaders. Bring your own three.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./src/index.js" }
  },
  "files": ["src", "index.d.ts", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": { "three": ">=0.184.0" },
  "devDependencies": { "three": "^0.184.0", "@types/three": "^0.184.0", "typescript": "^5.6.0" },
  "keywords": ["three", "threejs", "webgl", "webgpu", "3d", "scene", "orrery"],
  "license": "MIT"
}
