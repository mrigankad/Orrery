{
  "name": "@orreryjs/react",
  "version": "0.1.0",
  "description": "React bindings for Orrery: OrreryCanvas, useWorld, useFrame, useObject, useEvent, useLoad. You write plain three.js inside hooks.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "peerDependencies": {
    "orreryjs": ">=0.1.0",
    "react": ">=18",
    "three": ">=0.184.0"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.184.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrigankad/Orrery.git",
    "directory": "packages/react"
  },
  "homepage": "https://mrigankad.github.io/Orrery/docs/#react",
  "keywords": [
    "three",
    "threejs",
    "react",
    "webgpu",
    "orrery"
  ],
  "license": "MIT"
}
